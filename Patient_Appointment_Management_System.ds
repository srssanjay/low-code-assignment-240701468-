		workflow
		{
		form
		{
			auto_set_appointment_id as "Auto-Set Appointment ID"
			{
				type =  form
				form = appointment_booking

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// The appointment_id is an autonumber field and cannot be manually set.
										// It is automatically generated by Zoho Creator upon record creation.
										// No code is needed to populate this field.
										info "Appointment ID is auto-generated by the system. No manual assignment required.";
						)
					}
				}

			}
		}

		schedule
		{
			weekly_follow_up_reminder as "Weekly Follow-Up Reminder"
			{
				type =  schedule
				form = follow_up_reminder
					status = inactive
				start = follow_up_window_end at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch the follow-up reminder record using the input context
										followUpRecord = follow_up_reminder[ID == input.ID];
										// Check if the follow-up window end date is today or earlier
										if(followUpRecord.follow_up_window_end <= zoho.currentdate)
										{
											// Fetch the patient profile using the multi-select lookup
											patientRecords = patient_profile[ID in followUpRecord.patient.ID.getall()];
											// Iterate through each patient record
											for each  patient in patientRecords
											{
												// Construct the email subject
												subject = "Weekly Follow-Up Reminder";
												// Construct the email message with patient details
												patientName = input.patient.patient_name.first_name.concat(" ").concat(input.patient.patient_name.last_name);
												message = "Dear " + patientName + ",\n\nThis is a weekly follow-up reminder regarding your appointment.\n\nPlease contact us if you have any questions or concerns.";
												// Send the email notification to the patient
												sendmail
												[
													from :zoho.loginuserid
													to :input.patient.email_address
													subject :subject
													message :message
												]
											}
										}
					)
					}
				}
			}
		}


