				age as "Age"
				gender as "Gender"
				referred_by as "Referred By"
				existing_conditions as "Existing Conditions"
				symptoms_description as "Symptoms Description"
				consent_for_treatment as "Consent For Treatment"
			)
			options
			(
	 			display field = gender
	 		)
		}
		list department_load_chart_Report
		{
			displayName = "All Department Load Charts"
			show all rows from department_load_chart    
			(
				department as "Department"
				date_1 as "Date"
			)
		}
		kanban department_load_chart_by_department
		{
			displayName = "Departments"
			show all rows from department_load_chart    
			(
				department as "Department"
				date_1 as "Date"
			)
			options
			(
	 			display field = department
	 		)
		}
		list daily_target_log_Report
		{
			displayName = "Daily Target Log Report"
			show all rows from daily_target_log    
			(
				date_1 as "Date"
				actual_count as "Actual Count"
				capacity_percentage as "Capacity Percentage"
				(
					display = total,average,min,max	
				)
			)
		}
		list doctor_availability_log_Report
		{
			displayName = "Doctor Availability Log Report"
			show all rows from doctor_availability_log    
			(
				doctor as "Doctor"
				date_1 as "Date"
				time_slot as "Time Slot"
				is_available as "Is Available"
				current_queue_count as "Current Queue Count"
			)
		}
		list clinic_guidelines_snippet_Report
		{
			displayName = "All Clinic Guidelines Snippets"
			show all rows from clinic_guidelines_snippet    
			(
				guideline_text as "Guideline Text"
				last_updated as "Last Updated"
				version as "Version"
			)
		}
		list medical_report_viewer_Report
		{
			displayName = "All Medical Report Viewers"
			show all rows from medical_report_viewer    
			(
				appointment as "Appointment"
				report_file_name as "Report File Name"
				report_upload_date as "Report Upload Date"
				report_type as "Report Type"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (report_type == "Lab Report")
				fields = [report_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (report_type == "Prescription")
				fields = [report_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (report_type == "Previous History")
				fields = [report_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban medical_report_viewer_by_report_type
		{
			displayName = "Report Types"
			show all rows from medical_report_viewer    
			(
				appointment as "Appointment"
				report_file_name as "Report File Name"
				report_upload_date as "Report Upload Date"
				report_type as "Report Type"
			)
			options
			(
	 			display field = report_type
	 		)
		}
	}
