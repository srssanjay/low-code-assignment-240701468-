 application "Patient Appointment Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form accompanying_family_member
		{
			displayname = "Accompanying Family Member"
			success message = "Accompanying Family Member Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			appointment
			(
				type = list	
				displayname = "Appointment"
				values  = appointment_booking.ID
    			displayformat = [appointment_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			member_name
			(
    			type = name
				displayname = "Member Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			relation
			(
    			type = text
				displayname = "Relation"
	 			row = 1
	 			column = 1   
				width = medium
			)
			age
			(
				type = number
				displayname = "Age"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form appointment_booking
		{
			displayname = "Appointment Booking"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			patient
			(
				type = list	
				displayname = "Patient"
				values  = patient_profile.ID
    			displayformat = [patient_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_appointment_date
			(
    			type = date
				displayname = "Preferred Appointment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_appointment_time
			(
    			type = time
				displayname = "Preferred Appointment Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Neurology","Pediatrics","Orthopedics","General Medicine","ENT","Cardiology"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_id
			(
    			type = autonumber
				displayname = "Appointment ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_submitted_on
			(
    			type = datetime
				displayname = "Appointment Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_status
			(
				type = picklist
				displayname = "Appointment Status"
				values = {"Requested","Checked-In","Consulted","Pending Doctor Approval","Confirmed","Cancelled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			payment_status
			(
				type = picklist
				displayname = "Payment Status"
				values = {"Failed","Paid","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			net_payable_fee
			(
				displayname = "Net Payable Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			consultation_fee
			(
				displayname = "Consultation Fee"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			insurance_coverage_percent
			(
    			type = percentage
				displayname = "Insurance Coverage Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			requires_ambulance_pickup
			(
    			type = checkbox
				displayname = "Requires Ambulance Pickup"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			doctor
			(
				type = list	
				displayname = "Doctor"
				values  = doctor_master.ID
    			displayformat = [doctor_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_in_status
			(
				type = radiobuttons
				displayname = "Check-In Status"
				values = {"Checked In","Not Checked In"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			consultation_status
			(
				type = radiobuttons
				displayname = "Consultation Status"
				values = {"Consulted","Not Consulted"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			previous_report_portal_url
			(
    			type = url
				displayname = "Previous Report Portal URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			previous_medical_report_upload
			(
    			type = textarea
				displayname = "Previous Medical Report Upload"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			symptom_voice_note
			(
    			type = textarea
				displayname = "Symptom Voice Note"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			symptom_video
			(
    			type = textarea
				displayname = "Symptom Video"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient_photo
			(
    			type = textarea
				displayname = "Patient Photo"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			patient_digital_signature
			(
    			type = textarea
				displayname = "Patient Digital Signature"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			appointment_qr_code
			(
    			type = textarea
				displayname = "Appointment QR Code"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			clinic_guidelines_display
			(
    			type = textarea
				displayname = "Clinic Guidelines Display"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			body_temperature_f
			(
				type = decimal
				displayname = "Body Temperature F"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Appointment Draft","Appointment Submitted","Pending Doctor Approval","Appointment Cancelled","Appointment Approved","Appointment Rejected","Appointment Rescheduled","Payment Pending","Payment Confirmed","Appointment Scheduled","Patient Checked In","Consultation In Progress","Consultation Completed","Appointment Closed"}
			}
		}
