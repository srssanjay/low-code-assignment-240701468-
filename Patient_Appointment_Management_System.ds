				requires_ambulance_pickup as "Requires Ambulance Pickup"
				doctor as "Doctor"
				check_in_status as "Check-In Status"
				consultation_status as "Consultation Status"
				previous_report_portal_url as "Previous Report Portal URL"
				previous_medical_report_upload as "Previous Medical Report Upload"
				symptom_voice_note as "Symptom Voice Note"
				symptom_video as "Symptom Video"
				patient_photo as "Patient Photo"
				patient_digital_signature as "Patient Digital Signature"
				appointment_qr_code as "Appointment QR Code"
				clinic_guidelines_display as "Clinic Guidelines Display"
				body_temperature_f as "Body Temperature F"
			)
			options
			(
	 			display field = department
	 		)
		}
		list approval_request_Report
		{
			displayName = "All Approval Requests"
			show all rows from approval_request    
			(
				appointment as "Appointment"
				approver as "Approver"
				approval_status as "Approval Status"
				approval_comment as "Approval Comment"
				approved_on as "Approved On"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (approval_status == "Approved")
				fields = [approval_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (approval_status == "Pending")
				fields = [approval_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (approval_status == "Rejected")
				fields = [approval_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
